{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pip install .",
  "regions": ["bom1"],
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "memory": 1024,
      "excludeFiles": "{tests/**,__pycache__/**,**/*.pyc,**/.venv/**,.venv/**,.mypy_cache/**,.pytest_cache/**,.ruff_cache/**,.env,.env.*}"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ],
  "crons": [
    {
      "path": "/api/cron/publish-due",
      "schedule": "0 0 * * *"
    }
  ]
}
